#!/usr/bin/env python3
"""Simulated AngleMode action client for chapter examples."""
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from robot_arm_interfaces.action import AngleMode


class AngleModeClient(Node):
    def __init__(self):
        super().__init__('angle_mode_client')
        self._client = ActionClient(self, AngleMode, 'angle_mode')
        self.get_logger().info('AngleMode action client started')

    def feedback_callback(self, feedback_msg):
        fb = feedback_msg.feedback
        self.get_logger().info(
            f'反馈: progress={fb.progress:.0%}, elapsed={fb.elapsed_time:.2f}s, '
            f'angles={[round(v, 1) for v in fb.current_angles]}'
        )

    def send_goal(self):
        self.get_logger().info('等待 action server...')
        self._client.wait_for_server()

        goal = AngleMode.Goal()
        goal.angles = [0.0, 15.0, 30.0, 45.0, 60.0, 90.0]
        goal.speed_ratio = 1.0

        self.get_logger().info(f'发送目标: {list(goal.angles)}')
        send_future = self._client.send_goal_async(goal, feedback_callback=self.feedback_callback)
        rclpy.spin_until_future_complete(self, send_future)

        goal_handle = send_future.result()
        if goal_handle is None or not goal_handle.accepted:
            self.get_logger().error('目标被拒绝')
            return

        self.get_logger().info('目标已接受，等待结果...')
        result_future = goal_handle.get_result_async()
        rclpy.spin_until_future_complete(self, result_future)
        result = result_future.result().result
        self.get_logger().info(
            f'结果: success={result.success}, message="{result.message}", '
            f'execution_time={result.execution_time:.2f}s, final={[round(v, 1) for v in result.final_angles]}'
        )


def main():
    rclpy.init()
    node = AngleModeClient()
    try:
        node.send_goal()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
